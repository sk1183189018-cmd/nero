<Window x:Class="NERO.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NERO" Height="620" Width="960" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="{StaticResource NeroBackground}"
        Foreground="#F3F5FA">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="NERO" FontSize="34" FontWeight="Bold" />
            <TextBlock Text="Your Windows AI assistant foundation" Foreground="#AAB3C5" FontSize="14" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource NeroPanel}" CornerRadius="16" Padding="24">
                <StackPanel>
                    <TextBlock Text="Welcome to NERO" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#AAB3C5"
                               Text="The desktop foundation is running. Voice capture, wake-word detection and AI actions are not enabled yet; they will be added only with real implementations and permission controls." />
                    <TextBlock Margin="0,28,0,6" Text="CURRENT BUILD" Foreground="#8792A8" FontSize="11" />
                    <TextBlock Text="Phase 1 · Project foundation" FontSize="16" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{StaticResource NeroPanel}" CornerRadius="16" Padding="20">
                <StackPanel>
                    <TextBlock Text="System status" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Margin="0,18,0,4" Text="Desktop shell" Foreground="#AAB3C5" />
                    <TextBlock Text="Initialized" Foreground="{StaticResource NeroAccent}" />
                    <TextBlock Margin="0,16,0,4" Text="Microphone" Foreground="#AAB3C5" />
                    <TextBlock Text="Not connected" />
                    <TextBlock Margin="0,16,0,4" Text="AI provider" Foreground="#AAB3C5" />
                    <TextBlock Text="Not configured" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Margin="0,18,0,0" Foreground="#7F899D"
                   Text="NERO is running locally. No microphone audio is being captured." />
    </Grid>
</Window>
